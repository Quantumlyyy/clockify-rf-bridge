{
	"name": "clockify-rf-bridge",
	"private": true,
	"license": "UNLICENSED",
	"version": "0.0.1",
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=22.13"
	},
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter bridge dev",
		"build": "pnpm --filter bridge build",
		"preview": "pnpm --filter bridge preview",
		"prepare": "pnpm --filter bridge prepare",
		"check": "pnpm --filter bridge check",
		"check:watch": "pnpm --filter bridge check:watch",
		"lint": "oxfmt --check && oxlint && eslint .",
		"format": "oxfmt",
		"test": "pnpm -r test",
		"test:ci": "pnpm -r --if-present run test:ci",
		"gen": "pnpm --filter bridge gen",
		"db:generate": "pnpm --filter @clockify-rf-bridge/db db:generate"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@eslint/compat": "catalog:",
		"@eslint/js": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-drizzle": "catalog:",
		"eslint-plugin-oxlint": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"globals": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
